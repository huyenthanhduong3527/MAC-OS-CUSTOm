{
  "manifest_version": 3,
  "name": "Facebook Apple Emojis",
  "version": "1.0.0",
  "description": "Displays authentic Apple Color Emoji on Facebook and Messenger for Linux.",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.messenger.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
